{
	"extends": "@miguelriosoliveira/shared-configs/tsconfig/react",
	"compilerOptions": {
		"allowJs": true,
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
